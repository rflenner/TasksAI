# Copy to .env.local for local development. Never put real secrets in this file.
DATABASE_URL=postgresql://tasks_ai:change-me@localhost:5432/tasks_ai
DATABASE_SSL=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Used only by /voice-test-realtime (GPT Live) — OpenAI's Realtime API
# model/voice for true voice-to-voice, compared there against the
# existing Deepgram-based Ask Task AI. Separate from OPENAI_MODEL above,
# which is the plain text-classification model every other AI feature uses.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# Existing dictation feature (app/api/dictate/token, app/api/dictate/speak)
# and the /voice-test-deepgram comparison route — was previously undocumented.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TTS_VOICE=flux-drew-en
DEEPGRAM_TTS_SPEED=1
DEEPGRAM_TTS_EXPRESSIVITY=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
TASK_AI_FROM_EMAIL=Task AI <notifications@tasks.flenner.at>
# Svix signing secret Resend gives the inbound webhook (app/api/webhooks/inbound-email/route.ts) — without it, inbound email (forward-to-create-task, and reply-to-update-a-task) is silently disabled, not an error.
RESEND_INBOUND_WEBHOOK_SECRET=
# Domain Resend is configured to receive inbound mail on — deliberately separate from TASK_AI_FROM_EMAIL's sending domain above. Used to build the reply+{token}@ address a manual-notify email's reply-to gets set to. Falls back to tasks.iseeit.ai (see the inbound webhook route's own comment) if unset.
INBOUND_EMAIL_DOMAIN=tasks.iseeit.ai
BOOTSTRAP_SITE_ADMIN=false
SITE_ADMIN_EMAIL=rizan@flenner.at
SITE_ADMIN_FIRST_NAME=Rizan
SITE_ADMIN_LAST_NAME=Flenner
SITE_ADMIN_COMPANY=replace-with-company-name
